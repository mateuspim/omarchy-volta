#!/usr/bin/env bash
# Opt a contributor checkout into Volta's agent instructions.
#
# `omarchy plugin add` clones the whole repository into the user's plugin
# directory, so tracked AGENTS.md/CLAUDE.md files would be auto-loaded by any
# coding agent run there (ADR 15). The instructions live in
# docs/contributing/agent-instructions.md instead, and this script creates the
# gitignored root entry points that agents discover. Run it only in a checkout
# you develop in, never as part of installing the plugin.
#
# Usage: scripts/dev-setup [--remove]
set -uo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd) || {
  echo "dev-setup: cannot find the repository root; nothing was changed" >&2
  exit 1
}
instructions="docs/contributing/agent-instructions.md"
claude_line="@$instructions"
status=0

usage() {
  echo "Usage: scripts/dev-setup [--remove]"
  echo "Creates gitignored AGENTS.md (symlink) and CLAUDE.md (import) at the"
  echo "repository root, pointing at $instructions."
}

agents_is_ours() {
  [[ -L $root/AGENTS.md && $(readlink -- "$root/AGENTS.md") == "$instructions" ]]
}

claude_is_ours() {
  [[ -f $root/CLAUDE.md && ! -L $root/CLAUDE.md && $(cat -- "$root/CLAUDE.md") == "$claude_line" ]]
}

link_agents() {
  if agents_is_ours; then
    echo "AGENTS.md already points at $instructions"
    return
  fi
  if [[ -e $root/AGENTS.md || -L $root/AGENTS.md ]]; then
    echo "dev-setup: AGENTS.md exists and is not Volta's link; left it unchanged" >&2
    status=1
    return
  fi
  if ln -s -- "$instructions" "$root/AGENTS.md"; then
    echo "Linked AGENTS.md -> $instructions"
  else
    echo "dev-setup: could not create AGENTS.md; agents will not see the instructions" >&2
    status=1
  fi
}

write_claude() {
  if claude_is_ours; then
    echo "CLAUDE.md already imports $instructions"
    return
  fi
  if [[ -e $root/CLAUDE.md || -L $root/CLAUDE.md ]]; then
    echo "dev-setup: CLAUDE.md exists and is not Volta's import; left it unchanged" >&2
    status=1
    return
  fi
  if printf '%s\n' "$claude_line" > "$root/CLAUDE.md"; then
    echo "Wrote CLAUDE.md importing $instructions"
  else
    echo "dev-setup: could not write CLAUDE.md; Claude Code will not see the instructions" >&2
    status=1
  fi
}

# Both files must stay out of git, or the next install ships them again.
check_ignored() {
  command -v git >/dev/null 2>&1 || return
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 || return
  local file
  for file in AGENTS.md CLAUDE.md; do
    if git -C "$root" ls-files --error-unmatch -- "$file" >/dev/null 2>&1; then
      echo "dev-setup: $file is tracked by git; untrack it (ADR 15)" >&2
      status=1
    elif ! git -C "$root" check-ignore -q -- "$file"; then
      echo "dev-setup: $file is not gitignored; add it to .gitignore (ADR 15)" >&2
      status=1
    fi
  done
}

remove_ours() {
  if agents_is_ours; then
    rm -f -- "$root/AGENTS.md" && echo "Removed AGENTS.md"
  fi
  if claude_is_ours; then
    rm -f -- "$root/CLAUDE.md" && echo "Removed CLAUDE.md"
  fi
}

case ${1:-} in
  "")
    if [[ ! -f $root/$instructions ]]; then
      echo "dev-setup: $instructions is missing; nothing was changed" >&2
      exit 1
    fi
    link_agents
    write_claude
    check_ignored
    ;;
  --remove) remove_ours ;;
  -h|--help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
exit "$status"
